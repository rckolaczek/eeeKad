+static ssize_t send_all(const struct transferdata* const data, const char* const buffer, const size_t len) {
+
+	size_t sent = 0;
+
+	while (sent < len) {
+
+		const ssize_t w = (data->is_secure) ? ssl_send(data->context, buffer + sent, len - sent) : send(data->fd, buffer + sent, len - sent, 0);
+
+		if (w < 0 && errno == EINTR) {
+			continue;
+		}
+
+		if (w <= 0) {
+			return -1;
+		}
+
+		sent += (size_t) w;
+
+	}
+
+	return (ssize_t) len;
+
+}
